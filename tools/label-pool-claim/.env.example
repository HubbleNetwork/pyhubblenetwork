# Copy to .env (or .env.<name> for another org, used with --env <name>).
# Never commit the real files; .gitignore excludes everything but this one.

# Bearer token for the org (HUBBLE_API_TOKEN also works)
HUBBLE_API_KEY=
# The org's UUID
HUBBLE_ORG_ID=
# Optional; defaults to https://api.hubble.com
# HUBBLE_ENDPOINT=https://api.hubble.com
